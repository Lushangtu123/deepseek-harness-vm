{
  "rules": [
    {
      "id": "harness.python.eval",
      "languages": [
        "python"
      ],
      "severity": "ERROR",
      "message": "动态 eval：请核对输入来源，优先使用受限解析器",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-95"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "eval($VALUE)"
        },
        {
          "pattern-not": "eval(\"...\")"
        }
      ]
    },
    {
      "id": "harness.python.pickle",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "pickle 反序列化：请验证数据可信度，勿直接接受外部输入",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-502"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern-either": [
        {
          "pattern": "pickle.loads(...)"
        },
        {
          "pattern": "pickle.load(...)"
        }
      ]
    },
    {
      "id": "harness.python.shell",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "subprocess shell=True：请核对命令构造，优先参数数组与 shell=False",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-78"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern-either": [
        {
          "pattern": "subprocess.run(..., shell=True, ...)"
        },
        {
          "pattern": "subprocess.call(..., shell=True, ...)"
        },
        {
          "pattern": "subprocess.check_call(..., shell=True, ...)"
        },
        {
          "pattern": "subprocess.check_output(..., shell=True, ...)"
        },
        {
          "pattern": "subprocess.Popen(..., shell=True, ...)"
        }
      ]
    },
    {
      "id": "harness.python.yaml-load",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "yaml.load：请核对 Loader，优先 safe_load 或 SafeLoader",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-502"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "yaml.load(...)"
        },
        {
          "pattern-not": "yaml.load(..., Loader=yaml.SafeLoader, ...)"
        },
        {
          "pattern-not": "yaml.load(..., Loader=yaml.CSafeLoader, ...)"
        }
      ]
    },
    {
      "id": "harness.javascript.eval",
      "languages": [
        "javascript",
