    {
      "id": "harness.python.os-system",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "动态 os.system：请核对命令来源，优先无 Shell 的参数数组",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-78"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "os.system($VALUE)"
        },
        {
          "pattern-not": "os.system(\"...\")"
        }
      ]
    },
    {
      "id": "harness.python.requests-verify-false",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "requests 关闭证书验证：请恢复证书校验或配置可信 CA",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-295"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "requests.$METHOD(..., verify=False, ...)"
        },
        {
          "metavariable-regex": {
            "metavariable": "$METHOD",
            "regex": "^(get|post|put|delete|patch|head|options|request)$"
          }
        }
      ]
    },
    {
      "id": "harness.python.tempfile-mktemp",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "mktemp 只生成路径：请检查竞态，优先 mkstemp 或 NamedTemporaryFile",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-377"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern": "tempfile.mktemp(...)"
    },
    {
      "id": "harness.python.jwt-noverify",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "JWT 签名验证被关闭：请核对验证流程和允许的算法",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-347"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern": "jwt.decode(..., options={..., \"verify_signature\": False, ...}, ...)"
    },
    {
      "id": "harness.javascript.child-process-exec",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "动态 child_process.exec：请核对命令构造，优先 execFile 参数数组",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-78"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "child_process.exec($VALUE, ...)"
        },
        {
          "pattern-not": "child_process.exec(\"...\", ...)"
        }
      ]
    },
    {
      "id": "harness.javascript.dom-innerhtml",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "innerHTML 接收动态值：请核对转义/净化，纯文本优先 textContent",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-79"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "$ELEMENT.innerHTML = $VALUE"
        },
        {
          "pattern-not": "$ELEMENT.innerHTML = \"...\""
        }
      ]
    },
    {
      "id": "harness.javascript.document-write",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "document.write 接收动态值：请核对输入与上下文编码",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-79"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "patterns": [
        {
          "pattern": "document.write($VALUE, ...)"
        },
        {
          "pattern-not": "document.write(\"...\", ...)"
        }
      ]
    },
    {
      "id": "harness.javascript.tls-reject-disabled",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "HTTPS/TLS 证书验证被关闭：请核对并恢复证书校验",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-295"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern-either": [
        {
          "pattern": "https.request(..., {..., rejectUnauthorized: false, ...}, ...)"
        },
        {
          "pattern": "https.get(..., {..., rejectUnauthorized: false, ...}, ...)"
        },
        {
          "pattern": "https.Agent(..., {..., rejectUnauthorized: false, ...}, ...)"
        },
        {
          "pattern": "tls.connect(..., {..., rejectUnauthorized: false, ...}, ...)"
        },
        {
          "pattern": "new https.Agent({... , rejectUnauthorized: false, ...})"
        }
      ]
    },
    {
      "id": "harness.javascript.sql-concat",
      "languages": [
        "javascript",
        "typescript"
      ],
      "severity": "WARNING",
      "message": "query 字符串含拼接或插值：请验证占位符/绑定参数，核对实际数据库 API",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-89"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern-either": [
        {
          "pattern": "$DB.query(\"...\" + $VALUE, ...)"
        },
        {
          "pattern": "$DB.query(`...${$VALUE}...`, ...)"
        }
      ]
    }
  ]
}
