    {
      "id": "harness.python.sql-fstring",
      "languages": [
        "python"
      ],
      "severity": "WARNING",
      "message": "SQL f-string 含插值：请验证绑定参数，避免拼接不可信值",
      "metadata": {
        "category": "security",
        "cwe": [
          "CWE-89"
        ],
        "confidence": "MEDIUM",
        "source": "Harness local review heuristics",
        "requires-manual-review": true
      },
      "pattern": "$CURSOR.execute(f\"...{$VALUE}...\", ...)"
    },
    {
      "id": "harness.python.exec",
      "languages": [
